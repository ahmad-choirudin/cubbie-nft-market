# Optional. Cubbie World defaults to https://cubbie.web.id. Set this (https:// only) to override it.
VITE_CUBBIE_WORLD_URL=

# Real release time of the latest drop (ISO date, e.g. 2026-12-01T12:00:00Z). Leave empty to hide the countdown.
VITE_CUBBIE_DROP_AT=

# Web3 (optional). Fill both only after a contract is deployed.
# Without them the site stays in demo mode and shows no on-chain features.
VITE_CUBBIE_CONTRACT=
VITE_CUBBIE_CHAIN_ID=
